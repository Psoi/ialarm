<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IAlarm.ViewModels"
             xmlns:views="clr-namespace:IAlarm.Views"
             x:Class="IAlarm.Views.StopwatchPage"
             x:DataType="vm:StopwatchViewModel">

    <Grid RowDefinitions="*,Auto,Auto,*" Padding="16">

        <Border Grid.Row="1" Padding="12,28"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightPanel}, Dark={StaticResource DarkPanel}}">
            <VerticalStackLayout Spacing="10">
                <Label Text="STOPWATCH" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                <views:SegmentDisplay Text="{Binding DisplayText}" HeightRequest="120" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,24,0,0">
            <Button Text="START" Command="{Binding StartCommand}" />
            <Button Grid.Column="1" Text="STOP" Command="{Binding StopCommand}" />
            <Button Grid.Column="2" Text="RESET" Command="{Binding ResetCommand}" />
        </Grid>
    </Grid>
</ContentPage>
