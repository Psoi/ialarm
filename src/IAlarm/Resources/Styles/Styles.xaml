<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:IAlarm.Views">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPanel}, Dark={StaticResource DarkPanel}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
    </Style>

    <Style TargetType="views:SegmentDisplay">
        <Setter Property="LitColor" Value="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" />
        <Setter Property="GhostColor" Value="{AppThemeBinding Light={StaticResource LightGhost}, Dark={StaticResource DarkGhost}}" />
        <Setter Property="GlowColor" Value="{AppThemeBinding Light={StaticResource LightGlow}, Dark={StaticResource DarkGlow}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <!-- Outlined, like the buttons printed on a watch face -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="2" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="MinimumWidthRequest" Value="52" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightGhost}, Dark={StaticResource DarkGhost}}" />
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightGhost}, Dark={StaticResource DarkGhost}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="BorderColor" Value="{StaticResource Danger}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="2" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <!-- The round add button -->
    <Style x:Key="Fab" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" Opacity="0.5" Radius="12" Offset="0,0" />
        </Setter>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource LightLit}, Dark={StaticResource DarkLit}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="VerticalScrollBarVisibility" Value="Never" />
    </Style>
</ResourceDictionary>
